# Copy to deploy/.env and fill in values. Sourced by bootstrap.sh and deploy.sh.

# --- GCP ---
GCP_PROJECT=thelook-context-demo
GCP_REGION=us-central1

# --- naming ---
ARTIFACT_REPO=thelook-agent
SERVICE_NAME=thelook-agent
EVAL_JOB_NAME=thelook-agent-eval
SERVICE_ACCOUNT=thelook-agent-sa
BQ_DATASET=thelook_semantic
# Bucket names are globally unique — prefix with project id.
EVAL_BUCKET=thelook-context-demo-eval-results

# --- runtime ---
DBT_SL_HOST=semantic-layer.cloud.getdbt.com
DBT_SL_ENV_ID=                   # numeric env id from dbt Cloud, set after step 3
AGENT_MODEL=gemini-2.5-pro

# --- cost guardrails ---
BUDGET_AMOUNT_USD=50             # monthly budget alert threshold

# --- GitHub CI/CD (only needed if you run setup-trigger.sh) ---
GITHUB_OWNER=spoonepa             # your github user/org
GITHUB_REPO=thelook-semantic-agent
CLOUDBUILD_SA=cloudbuild-runtime-sa
TRIGGER_NAME=thelook-agent-main
TRIGGER_BRANCH=^main$            # regex; e.g. ^(main|release/.*)$
